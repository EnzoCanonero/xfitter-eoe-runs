#!/bin/bash
# plot command (PDF comparison)
# Overlays PDFs from several fits into plots/pdf_comparison.pdf.
# Sources an LCG view from CVMFS for matplotlib/numpy/yaml/lhapdf only if needed.

LCG_SETUP=${LCG_SETUP:-/cvmfs/sft.cern.ch/lcg/views/LCG_106/x86_64-el9-gcc13-opt/setup.sh}

# Only source CVMFS if the required Python modules are not already available.
if ! python3 -c "import matplotlib, numpy, yaml, lhapdf" 2>/dev/null; then
    source "$LCG_SETUP"
fi

# Resolve the directory containing this script (handles symlinks).
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

exec python3 "$SCRIPT_DIR/plot.py" "$@"
