#!/bin/bash
# plot-xsec command (cross-section comparison)
# Overlays reduced cross sections of several fits into plots/xsec_comparison.pdf
# using the real xfitter-draw (Fig.2 style: logo, hatched therr bands, delta-total
# band, Theory+shifts, ratio panel). Panel selection via config.yaml.
#
# Needs the xfitter environment (ROOT + the xfitter-draw binary). Sources the
# repo's scripts/setup-env.sh to select and validate the requested build even
# when another xfitter-draw is already in PATH.

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if ! source "$REPO_ROOT/scripts/setup-env.sh" >/dev/null; then
    echo "plot-xsec: failed to initialize the requested xFitter build" >&2
    exit 1
fi

export XFITTER_EOE_REPO_ROOT="$REPO_ROOT"
export PYTHONPATH="$REPO_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"

exec python3 -m xfitter_eoe_runs.cli.plot_xsec "$@"
