#!/bin/bash
# plot-scan command
# Extracts results and generates plots for a scan workspace
# Sources LCG_106 from CVMFS for matplotlib/pandas/numpy only if needed

LCG_SETUP=${LCG_SETUP:-/cvmfs/sft.cern.ch/lcg/views/LCG_106/x86_64-el9-gcc13-opt/setup.sh}

# Only source CVMFS if matplotlib/pandas are not already available
if ! python3 -c "import matplotlib, pandas, numpy" 2>/dev/null; then
    source "$LCG_SETUP"
fi

# Resolve the directory containing this script (handles symlinks)
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

export XFITTER_EOE_REPO_ROOT="$REPO_ROOT"
export PYTHONPATH="$REPO_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"

exec python3 -m xfitter_eoe_runs.cli.plot_scan "$@"
