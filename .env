# Set your xFitter install path here.
# This path must be accessible from Condor worker nodes (e.g. on NFS).
XFITTER_ROOT=/nfs/scratch2/ecanoner/PDF
# e.g. XFITTER_ROOT=/nfs/scratch2/ecanoner/PDF

# Select the current general-purpose xFitter build. This is a directory name
# under $XFITTER_ROOT, not a Git branch name.
XFITTER_TREE=xfitter-master

# Optional: require the selected tree to be checked out at one exact, full
# commit. Per-study/generated-worker values override this repository default.
XFITTER_COMMIT=bd0470d93a433ebfb5d99f6c0fecda9c29141199

# To run a retained historical study, select its original build explicitly:
# XFITTER_TREE=xfitter-bartlett-fixes
