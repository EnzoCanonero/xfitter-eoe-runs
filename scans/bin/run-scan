#!/usr/bin/python3
"""
run-scan command
Generates fits and submits to Condor for a scan study
"""

import sys
from pathlib import Path
import argparse

# Add scans/ to Python path so we can import lib package
# Use .resolve() to handle symlinks correctly
scans_dir = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(scans_dir))

from lib.runner import run_scan


def main():
    parser = argparse.ArgumentParser(
        description="Generate fits and submit scan to Condor"
    )
    parser.add_argument(
        '--dry-run',
        action='store_true',
        help="Preview what would be done without creating files"
    )
    parser.add_argument(
        '--no-submit',
        action='store_true',
        help="Generate fits but do not submit to Condor"
    )
    args = parser.parse_args()

    # Detect current directory is a study directory (contains config.yaml)
    study_dir = Path.cwd()
    config_file = study_dir / "config.yaml"

    if not config_file.exists():
        print(f"Error: No config.yaml found in current directory: {study_dir}")
        print("\nThis command must be run from within a study directory.")
        print("Example: cd scans/studies/my-study && run-scan")
        sys.exit(1)

    try:
        run_scan(study_dir, dry_run=args.dry_run, submit=not args.no_submit)
    except Exception as e:
        print(f"Error: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)


if __name__ == '__main__':
    main()
