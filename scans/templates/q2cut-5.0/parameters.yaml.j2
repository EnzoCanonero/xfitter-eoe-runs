Minimizer: MINUIT
MINUIT:
  Commands: |
    call fcn 1
    set str 2
    migrad
    call fcn 3
{% if do_errors %}
  doErrors: |
    {{ do_errors | indent(4) }}
{% endif %}

# HERAPDF baseline parametrization initialized AT the converged minimum
# (chi2=1272.31/1089) of fits/hera/Q2cut/q2cut-5.0 (Q2_min=5.0, MIGRAD CONVERGED).
# value = best-fit central value, step = MINUIT parameter error.
Parameters:
  Ag   :  DEPENDENT
  Bg   : [ -0.20658, 0.021541 ]
  Cg   : [ 4.6858, 0.26713 ]
  Agp  : [ 0.23655, 0.033552 ]  # negative gluon ....
  Bgp  : [ -0.44294, 0.015628 ]
  Cgp  : [ 25.0,      0.       ]  # fix C of negative gluon
  Auv  :  DEPENDENT
  Buv  : [ 0.76643, 0.016714 ]
  Cuv  : [ 4.8696, 0.060928 ]
  Euv  : [ 12.019, 0.9402 ]
  Adv  :  DEPENDENT
  Bdv  : [ 0.94973, 0.06032 ]
  Cdv  : [ 4.5371, 0.29179 ]
  CUbar: [ 7.237, 0.66627 ]
  DUbar: [ 2.91, 1.0955 ]
  ADbar: [ 0.25888, 0.011289 ]
  BDbar: [ -0.12786, 0.0061469 ]
  CDbar:
    value: 8.9131
    step: 1.3532
  ZERO : [ 0. ]          # zero
  fs   : [ 0.4, 0.0 ]
  fd   : "=1-fs"
  AUbar: "=(1-fs)*ADbar"

Parameterisations:
  par_uv:
    class: HERAPDF
    parameters: [Auv,Buv,Cuv,ZERO,Euv]
  par_dv:
    class: HERAPDF
    parameters: [Adv,Bdv,Cdv]
  par_Ubar: # = ubar
    class: HERAPDF
    parameters: [AUbar,BDbar,CUbar,DUbar]
  par_Dbar: # = dbar + sbar
    class: HERAPDF
    parameters: [ADbar,BDbar,CDbar]
  par_dbar: # = (1-fs) Dbar
    class: Factor
    input: par_Dbar
    factor: fd
  par_s: # = sbar = fs Dbar
    class: Factor
    input: par_Dbar
    factor: fs
  par_g:
    class: NegativeGluon
    parameters: [Ag,Bg,Cg,ZERO,ZERO,Agp,Bgp,Cgp]

DefaultDecomposition: proton
Decompositions:
  proton:
    class: UvDvUbarDbarS
    # Note that HERAPDF parameterises Ubar and Dbar,
    # but this decomposition uses ubar and dbar
    xuv: par_uv
    xdv: par_dv
    xubar: par_Ubar
    xdbar: par_dbar
    xs: par_s
    xg: par_g

DefaultEvolution: proton-QCDNUM

Evolutions:
  proton-QCDNUM:
    ? !include evolutions/QCDNUM.yaml
    decomposition: proton #this could be omitted, as the default decomposition is set

# QCD parameters
Order: NNLO
NFlavour: 5
isFFNS: 0
Q0 : 1.378404875209 # Initial scale =sqrt(1.9)
alphas : 0.118

? !include constants.yaml



byReaction:
  # RT DIS scheme settings:
  RT_DISNC:
    ? !include reactions/RT_DISNC.yaml

# Specify HF scheme used for DIS NC processes:
hf_scheme_DISNC :
  defaultValue : 'RT_DISNC'        # global specification

# Specify HF scheme used for DIS CC processes:
hf_scheme_DISCC :
  defaultValue : 'BaseDISCC'       # global specification

WriteLHAPDF6:
  name: "proton"
  description: "..."
  authors: "..."
  reference: "..."
    # use DefaultEvolution
  #evolution: proton-QCDNUM
    # take internal grid
  preferInternalGrid:
    # or define grid
  #Xrange: [1e-4, 1]
  #Qrange: [1,1000]
  #Xnpoints: 200
  #Qnpoints: 120

# Output directory (patched at runtime by run_fit.sh)
OutputDirectory: "__SET_AT_RUNTIME__"
