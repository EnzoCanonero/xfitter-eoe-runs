Minimizer: MINUIT
MINUIT:
  Commands: |
    call fcn 1
    set str 2
    migrad
    call fcn 3
{% if do_errors %}
  doErrors: |
    {{ do_errors | indent(4) }}
{% endif %}

# HERAPDF baseline parametrization initialized AT the converged minimum
# (chi2=1251.79/1078) of fits/hera/Q2cut/q2cut-6.5 (Q2_min=6.5, MIGRAD CONVERGED).
# value = best-fit central value, step = MINUIT parameter error.
Parameters:
  Ag   :  DEPENDENT
  Bg   : [ -0.3028, 0.016705 ]
  Cg   : [ 4.3581, 0.22368 ]
  Agp  : [ 0.33191, 0.029906 ]  # negative gluon ....
  Bgp  : [ -0.47215, 0.010506 ]
  Cgp  : [ 25.0,      0.       ]  # fix C of negative gluon
  Auv  :  DEPENDENT
  Buv  : [ 0.75119, 0.016394 ]
  Cuv  : [ 4.8823, 0.059768 ]
  Euv  : [ 12.8, 0.95875 ]
  Adv  :  DEPENDENT
  Bdv  : [ 0.91338, 0.057886 ]
  Cdv  : [ 4.3941, 0.28043 ]
  CUbar: [ 7.442, 0.6081 ]
  DUbar: [ 4.1015, 1.124 ]
  ADbar: [ 0.23962, 0.010885 ]
  BDbar: [ -0.13976, 0.0065312 ]
  CDbar:
    value: 8.1487
    step: 1.2027
  ZERO : [ 0. ]          # zero
  fs   : [ 0.4, 0.0 ]
  fd   : "=1-fs"
  AUbar: "=(1-fs)*ADbar"

Parameterisations:
  par_uv:
    class: HERAPDF
    parameters: [Auv,Buv,Cuv,ZERO,Euv]
  par_dv:
    class: HERAPDF
    parameters: [Adv,Bdv,Cdv]
  par_Ubar: # = ubar
    class: HERAPDF
    parameters: [AUbar,BDbar,CUbar,DUbar]
  par_Dbar: # = dbar + sbar
    class: HERAPDF
    parameters: [ADbar,BDbar,CDbar]
  par_dbar: # = (1-fs) Dbar
    class: Factor
    input: par_Dbar
    factor: fd
  par_s: # = sbar = fs Dbar
    class: Factor
    input: par_Dbar
    factor: fs
  par_g:
    class: NegativeGluon
    parameters: [Ag,Bg,Cg,ZERO,ZERO,Agp,Bgp,Cgp]

DefaultDecomposition: proton
Decompositions:
  proton:
    class: UvDvUbarDbarS
    # Note that HERAPDF parameterises Ubar and Dbar,
    # but this decomposition uses ubar and dbar
    xuv: par_uv
    xdv: par_dv
    xubar: par_Ubar
    xdbar: par_dbar
    xs: par_s
    xg: par_g

DefaultEvolution: proton-QCDNUM

Evolutions:
  proton-QCDNUM:
    ? !include evolutions/QCDNUM.yaml
    decomposition: proton #this could be omitted, as the default decomposition is set

# QCD parameters
Order: NNLO
NFlavour: 5
isFFNS: 0
Q0 : 1.378404875209 # Initial scale =sqrt(1.9)
alphas : 0.118

? !include constants.yaml



byReaction:
  # RT DIS scheme settings:
  RT_DISNC:
    ? !include reactions/RT_DISNC.yaml

# Specify HF scheme used for DIS NC processes:
hf_scheme_DISNC :
  defaultValue : 'RT_DISNC'        # global specification

# Specify HF scheme used for DIS CC processes:
hf_scheme_DISCC :
  defaultValue : 'BaseDISCC'       # global specification

WriteLHAPDF6:
  name: "proton"
  description: "..."
  authors: "..."
  reference: "..."
    # use DefaultEvolution
  #evolution: proton-QCDNUM
    # take internal grid
  preferInternalGrid:
    # or define grid
  #Xrange: [1e-4, 1]
  #Qrange: [1,1000]
  #Xnpoints: 200
  #Qnpoints: 120

# Output directory (patched at runtime by run_fit.sh)
OutputDirectory: "__SET_AT_RUNTIME__"
