Minimizer: MINUIT
MINUIT:
  Commands: |
    call fcn 1
    set str 2
    migrad
    call fcn 3
{% if do_errors %}
  doErrors: |
    {{ do_errors | indent(4) }}
{% endif %}

# HERAPDF baseline parametrization initialized AT the converged minimum
# (chi2=1204.14/1042) of fits/Q2cut/q2cut-8.0 (Q2_min=8.0, MIGRAD CONVERGED).
# value = best-fit central value, step = MINUIT parameter error.
Parameters:
  Ag   :  DEPENDENT
  Bg   : [ -0.39773, 0.013049 ]
  Cg   : [ 3.9323, 0.19268 ]
  Agp  : [ 0.38274, 0.024992 ]  # negative gluon ....
  Bgp  : [ -0.51784, 0.0080693 ]
  Cgp  : [ 25.0,      0.       ]  # fix C of negative gluon
  Auv  :  DEPENDENT
  Buv  : [ 0.74695, 0.01615 ]
  Cuv  : [ 4.8858, 0.058978 ]
  Euv  : [ 12.994, 0.94975 ]
  Adv  :  DEPENDENT
  Bdv  : [ 0.90531, 0.055648 ]
  Cdv  : [ 4.3687, 0.27072 ]
  CUbar: [ 7.6779, 0.58314 ]
  DUbar: [ 4.9396, 1.1638 ]
  ADbar: [ 0.22881, 0.011882 ]
  BDbar: [ -0.14616, 0.0079511 ]
  CDbar:
    value: 7.9799
    step: 1.1537
  ZERO : [ 0. ]          # zero
  fs   : [ 0.4, 0.0 ]
  fd   : "=1-fs"
  AUbar: "=(1-fs)*ADbar"

Parameterisations:
  par_uv:
    class: HERAPDF
    parameters: [Auv,Buv,Cuv,ZERO,Euv]
  par_dv:
    class: HERAPDF
    parameters: [Adv,Bdv,Cdv]
  par_Ubar: # = ubar
    class: HERAPDF
    parameters: [AUbar,BDbar,CUbar,DUbar]
  par_Dbar: # = dbar + sbar
    class: HERAPDF
    parameters: [ADbar,BDbar,CDbar]
  par_dbar: # = (1-fs) Dbar
    class: Factor
    input: par_Dbar
    factor: fd
  par_s: # = sbar = fs Dbar
    class: Factor
    input: par_Dbar
    factor: fs
  par_g:
    class: NegativeGluon
    parameters: [Ag,Bg,Cg,ZERO,ZERO,Agp,Bgp,Cgp]

DefaultDecomposition: proton
Decompositions:
  proton:
    class: UvDvUbarDbarS
    # Note that HERAPDF parameterises Ubar and Dbar,
    # but this decomposition uses ubar and dbar
    xuv: par_uv
    xdv: par_dv
    xubar: par_Ubar
    xdbar: par_dbar
    xs: par_s
    xg: par_g

DefaultEvolution: proton-QCDNUM

Evolutions:
  proton-QCDNUM:
    ? !include evolutions/QCDNUM.yaml
    decomposition: proton #this could be omitted, as the default decomposition is set

# QCD parameters
Order: NNLO
NFlavour: 5
isFFNS: 0
Q0 : 1.378404875209 # Initial scale =sqrt(1.9)
alphas : 0.118

? !include constants.yaml



byReaction:
  # RT DIS scheme settings:
  RT_DISNC:
    ? !include reactions/RT_DISNC.yaml

# Specify HF scheme used for DIS NC processes:
hf_scheme_DISNC :
  defaultValue : 'RT_DISNC'        # global specification

# Specify HF scheme used for DIS CC processes:
hf_scheme_DISCC :
  defaultValue : 'BaseDISCC'       # global specification

WriteLHAPDF6:
  name: "proton"
  description: "..."
  authors: "..."
  reference: "..."
    # use DefaultEvolution
  #evolution: proton-QCDNUM
    # take internal grid
  preferInternalGrid:
    # or define grid
  #Xrange: [1e-4, 1]
  #Qrange: [1,1000]
  #Xnpoints: 200
  #Qnpoints: 120

# Output directory (patched at runtime by run_fit.sh)
OutputDirectory: "__SET_AT_RUNTIME__"
