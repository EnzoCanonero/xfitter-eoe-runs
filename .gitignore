# Run workspaces retain tracked configurations and launchers, not runtime payloads.
# Manual fit products are generated beneath their workspace.
runs/fits/**/output/
runs/fits/**/condor/run_fit.sh
runs/fits/**/condor/job.sub
runs/fits/**/condor/logs/
runs/fits/**/batch/*.log
runs/fits/**/*.dat
runs/fits/sandbox/*
!runs/fits/sandbox/.gitkeep

# Scan and comparison config.yaml files are tracked in their run workspaces;
# their generated products are ignored below.
runs/scans/**/runs/
runs/scans/**/plots/
runs/scans/**/results/
runs/comparisons/**/plots/
runs/comparisons/**/results/
runs/comparisons/**/.xfdraw-staging/

# Python cache
__pycache__/
*.pyc
*.pyo

# Python packaging artifacts
/build/
/dist/
*.egg-info/
