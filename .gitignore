# xfitter output (created at runtime), including backups
fits/**/output/
fits/**/output_OLD/
fits/**/output_bkp*/
fits/**/bkpref/

# PDF-comparison plot and table outputs
fits/compare/**/plots/
fits/compare/**/results/

# Condor generated files (created by submit.sh)
fits/**/condor/run_fit.sh
fits/**/condor/job.sub
fits/**/condor/logs/
fits/**/batch/*.log

# Data files in config/ (copied by new_fit.sh)
fits/**/*.dat

# Local one-off study grids
fits/hera/hera-pumplin-stability-sysHZComb1053/

# Local repair helper
fits/fix_lhapdf_info.sh

# Sandbox (personal throwaway fits), keep folder tracked
fits/sandbox/*
!fits/sandbox/.gitkeep

# Scan framework generated files
extra plots/
scans/fits/lambda-scans/*/fits/
scans/fits/lambda-scans/*/results/
scans/fits/lambda-scans/*/plots/
scans/fits/systematic-ranking/*/fits/
scans/fits/systematic-ranking/*/results/
scans/fits/systematic-ranking/*/plots/
scans/studies/**/runs/
scans/studies/**/plots/
scans/studies/**/results/

# Shared pipeline symlinks in study folders (point to scans/bin/)
scans/studies/**/plot
scans/studies/**/run-scan

# Python cache
__pycache__/
*.pyc
*.pyo
